<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- The tray icon is the in-box WinForms NotifyIcon. WPF and WinForms share type names, so no implicit usings. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Sway</AssemblyName>
    <RootNamespace>Sway.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF takes its DPI mode from the manifest; this WinForms analyzer only knows the WinForms way. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sway.Core\Sway.Core.csproj" />
    <ProjectReference Include="..\Sway.Platform.Windows\Sway.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
