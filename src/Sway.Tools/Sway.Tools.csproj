<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike and diagnostic console programs, run by hand on the Windows desktop (PLAN.md section 7, W1). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyName>SwayTools</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The one allowed third-party dependency (SPEC D4): local inference only, no network code. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The face model is fetched by scripts/fetch-pose-model.sh and never committed. -->
    <Content Include="models\*.onnx" CopyToOutputDirectory="PreserveNewest" LinkBase="models" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sway.Core\Sway.Core.csproj" />
    <ProjectReference Include="..\Sway.Platform.Windows\Sway.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
